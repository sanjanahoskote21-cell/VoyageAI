# VoyageAI backend configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=VoyageAI
# "development" lets the API return password-reset and email-verification
# links in the response when SMTP isn't configured. Use "production" when deployed.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# --- Database (Supabase Postgres connection string) ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# --- JWT auth ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Email (Gmail SMTP; leave blank to skip sending) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, use an app password, not your account password.
SMTP_PASSWORD=

# --- External APIs (optional; features fall back to mock data without them) ---
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
BREVO_API_KEY=
GEMINI_TIMEOUT_SECONDS=
GEMINI_MODELS=